# Copy this to .env and fill in your values
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Multi-Key Rotation Pool for Gemini LLM Engine (comma-separated)
# GEMINI_API_KEYS=key1,key2,key3

# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# Admin API Key for protected endpoints
ADMIN_API_KEY=your-admin-api-key-here

# Enable real browser screenshots via Selenium headless Chrome
SCREENSHOT_ENABLED=0
