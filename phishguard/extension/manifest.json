{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "2.0.0",
  "description": "AI-powered phishing detector with SHAP/Grad-CAM explainability, Gemini 2.5 Pro narrative summaries, on-device ONNX inference, and multilingual detection.",

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webNavigation"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "model/phishguard_url_classifier.onnx",
        "model/model_meta.json"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-grey-16.png",
      "32": "icons/icon-grey-32.png",
      "48": "icons/icon-grey-48.png",
      "128": "icons/icon-grey-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-grey-16.png",
    "48": "icons/icon-grey-48.png",
    "128": "icons/icon-grey-128.png"
  }
}

