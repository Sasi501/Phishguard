# Copy this file to .env and replace each placeholder before running locally.
# Never commit a real .env file to the repository.
DJANGO_SECRET_KEY=replace-with-a-random-secret
APP_SECRET_KEY=replace-with-a-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_API_KEYS=replace-with-gemini-api-key-1,replace-with-gemini-api-key-2
MONGODB_URI=mongodb://localhost:27017/phishguard
REDIS_URL=
ADMIN_API_KEY=replace-with-random-admin-key
SCREENSHOT_ENABLED=0
